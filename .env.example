# =============================================================================
# discord-agent — przykladowa konfiguracja srodowiska (.env.example)
# Skopiuj do .env i uzupelnij wartosci. NIE commituj prawdziwego .env!
#
# [WYMAGANA]  = odczyt przez getEnvVariableUnsafe — brak zmiennej wywala aplikacje
# [OPCJONALNA] = ma fallback/default (podany w komentarzu)
# =============================================================================

# --- Aplikacja / pigeon-package (@jsm-mit/pigeon-package) --------------------

# [WYMAGANA] Nazwa aplikacji uzywana w powiadomieniach pigeon-package.
# Czytana JUZ PRZY IMPORCIE paczki — bez niej proces nie wystartuje.
APP_NAME=discord-agent

# [OPCJONALNA] Tryb "tylko konsola" dla pigeon-package (default: false).
# Ustaw na "true", zeby pigeon logowal tylko do konsoli — wtedy zmienne
# PIGEON_* ponizej NIE sa potrzebne. Przy false (lub braku) wszystkie
# PIGEON_* staja sie wymagane przy imporcie paczki.
PIGEON_CONSOLE_ONLY=

# [WYMAGANA gdy PIGEON_CONSOLE_ONLY != true] Adres e-mail admina,
# na ktory pigeon-package wysyla alerty (odbiorca maili).
PIGEON_ADMIN_EMAIL=

# [WYMAGANA gdy PIGEON_CONSOLE_ONLY != true] Haslo SMTP z panelu Brevo
# (pigeon wysyla maile przez smtp-relay.brevo.com).
PIGEON_EMAIL_PASSWORD=

# [WYMAGANA gdy PIGEON_CONSOLE_ONLY != true] Account SID z konsoli Twilio
# (alerty telefoniczne pigeon-package).
PIGEON_TWILIO_ACCOUNT_SID=

# [WYMAGANA gdy PIGEON_CONSOLE_ONLY != true] Auth Token z konsoli Twilio.
PIGEON_TWILIO_AUTH_TOKEN=

# [WYMAGANA gdy PIGEON_CONSOLE_ONLY != true] Numer telefonu Twilio,
# Z KTOREGO wykonywane sa polaczenia alarmowe (format E.164, np. +1...).
PIGEON_TWILIO_NUMBER=

# [WYMAGANA gdy PIGEON_CONSOLE_ONLY != true] Numer telefonu, NA KTORY
# pigeon dzwoni przy pilnych alertach (format E.164, np. +48...).
PIGEON_CALL_TO_NUMBER=

# --- Internet Computer (canistery Motoko) ------------------------------------

# [WYMAGANA] ID canistera rabbit-motoko (kolejka zadan / task worker).
# Uzywana w src/index.ts; wartosc z deploymentu canistera (dfx / dashboard IC).
RABBIT_MOTOKO_CANISTER_ID=

# [WYMAGANA] ID canistera investments-motoko.
# Uzywana w src/index.ts; wartosc z deploymentu canistera (dfx / dashboard IC).
INVESTMENTS_MOTOKO_CANISTER_ID=

# [WYMAGANA] Tozsamosc ICP: zawartosc klucza prywatnego w formacie PEM
# (Secp256k1), przekazywana do getIdentityFromPem w src/index.ts.
# Wklej cala zawartosc pliku .pem (nowe linie jako \n albo w cudzyslowie).
IDENTITY_PEM=

# --- Discord / OpenAI --------------------------------------------------------

# [WYMAGANA] Token konta Discord (selfbot — discord.js-selfbot-v13),
# uzywany w src/index.ts do zalogowania klienta Discord.
DISCORD_TOKEN=

# [WYMAGANA] Klucz API OpenAI (platform.openai.com) — src/index.ts
# (ParserService); uzywany tez w testach (tests/parser.service.spec.ts).
OPENAI_API=

# --- Uslugi HTTP -------------------------------------------------------------

# [WYMAGANA] Bazowy URL backendu Octopus (OctopusService, src/index.ts).
# Produkcja (docker compose): http://octopus-backend:3000
OCTOPUS_URL=http://localhost:3000

# [WYMAGANA] URL serwisu system-heartbeat — watchdog wysyla tam POST
# /heartbeat (src/watchdog.service.ts).
# Produkcja (docker compose): http://system-heartbeat:4000
HEARTBEAT_URL=http://localhost:4000

# [WYMAGANA] Haslo do serwisu system-heartbeat (naglowek x-password
# w src/watchdog.service.ts). Musi zgadzac sie z konfiguracja system-heartbeat.
HEARTBEAT_PASSWORD=
